# Copy this file to .env.local for local development.
# QuorumMind runs in deterministic demo mode by default and does not require API keys.

QUORUMMIND_PROVIDER_MODE=demo
QUORUMMIND_API_HOST=127.0.0.1
QUORUMMIND_API_PORT=8787

# API security controls. Defaults are local-first and suitable for local dev.
# Set QUORUMMIND_API_TOKEN when binding the API beyond localhost.
# Before sharing with other users, use an exact CORS allowlist, enable Token auth,
# keep rate/body limits conservative, and enable HSTS behind HTTPS.
# QUORUMMIND_API_TOKEN=
# VITE_QUORUMMIND_API_TOKEN=
# QUORUMMIND_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174
# QUORUMMIND_RATE_LIMIT_MAX=60
# QUORUMMIND_RATE_LIMIT_WINDOW_MS=60000
# QUORUMMIND_MAX_BODY_BYTES=262144
# QUORUMMIND_ENABLE_HSTS=0

# Optional server-side persistence. When set, /api/decisions stores a full
# Decision Room snapshot and reputation feedback in SQLite.
# QUORUMMIND_SQLITE_PATH=.quorummind/quorummind.db

# Keyless live-like demo mode. Use with QUORUMMIND_PROVIDER_MODE=live.
# This exercises provider trace, schema validation, retry metadata, and live
# aggregation without calling external APIs.
# QUORUMMIND_MOCK_PROVIDERS=1

# Recommended: unified model gateway mode.
# Use this when one API key + one base URL can call multiple models.
#
# QUORUMMIND_PROVIDER_MODE=live
# MODEL_GATEWAY_API_KEY=
# MODEL_GATEWAY_BASE_URL=https://your-provider.example.com/v1
#
# Option A: comma-separated model seats used by the decision room.
# MODEL_GATEWAY_MODELS=gpt-4o-mini,deepseek-chat,gemini-2.0-flash-lite
#
# Option B: named seats, used when MODEL_GATEWAY_MODELS is empty.
# MODEL_GATEWAY_GPT_MODEL=gpt-4o-mini
# MODEL_GATEWAY_DEEPSEEK_MODEL=deepseek-chat
# MODEL_GATEWAY_GEMINI_MODEL=gemini-2.0-flash-lite
#
# Optional safety switch: skip unstable live seats by model or provider:model.
# QUORUMMIND_DISABLED_LIVE_MODELS=gpt-5.4-mini,gemini:gemini-3.1-pro-preview

# Direct provider keys are optional fallback slots.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4o-mini
#
# DEEPSEEK_API_KEY=
# DEEPSEEK_MODEL=deepseek-chat
#
# GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash-lite

# Live model quality audit controls. Defaults keep real API usage small.
# Suites:
# - smoke: 4 Chinese fast-mode cases, suitable for regular checks.
# - expanded: smoke + Chinese Deep/Red-team cases, uses more real API calls.
# - full: core 12-case real API regression suite, highest API cost.
# Every live audit appends docs/quality/live-model-quality-trend.jsonl.
# QUORUMMIND_LIVE_AUDIT_SUITE=smoke
# QUORUMMIND_LIVE_AUDIT_LIMIT=4
# Optional comma-separated case id filter for targeted reruns.
# QUORUMMIND_LIVE_AUDIT_CASE_IDS=tenant-zh-fast,agent-framework-zh-red-team
# Smoke defaults to 120000ms; expanded/full default to 180000ms.
# QUORUMMIND_LIVE_AUDIT_TIMEOUT_MS=120000
# QUORUMMIND_LIVE_PROVIDER_TIMEOUT_MS=60000
# QUORUMMIND_PROVIDER_TEST_TIMEOUT_MS=30000
# QUORUMMIND_PROVIDER_DEEP_TEST_TIMEOUT_MS=90000
# Incremental harness controls for long real-provider audits.
# QUORUMMIND_LIVE_AUDIT_PROGRESS_PATH=output/audit-progress/live-model.jsonl
# QUORUMMIND_LIVE_AUDIT_RESUME=1
# QUORUMMIND_LIVE_AUDIT_MAX_RUNTIME_MS=600000
# For script self-check only; marks reports as providerSource=mock.
# QUORUMMIND_LIVE_AUDIT_ALLOW_MOCK=1

# Live Blueprint quality audit controls. This checks /api/blueprints and
# /api/agent-runs/blueprint. Defaults are 20 cases and 3 provider phases
# to keep cost bounded; set max rounds to 5 for full deep Blueprint traces.
# QUORUMMIND_BLUEPRINT_LIVE_AUDIT_LIMIT=20
# QUORUMMIND_BLUEPRINT_LIVE_AUDIT_MAX_PROVIDER_ROUNDS=3
# QUORUMMIND_BLUEPRINT_LIVE_AUDIT_TIMEOUT_MS=180000
# QUORUMMIND_BLUEPRINT_LIVE_AUDIT_PROGRESS_PATH=output/audit-progress/live-blueprint.jsonl
# QUORUMMIND_BLUEPRINT_LIVE_AUDIT_RESUME=1
# QUORUMMIND_BLUEPRINT_LIVE_AUDIT_MAX_RUNTIME_MS=600000
# For script self-check only; marks reports as providerSource=mock.
# QUORUMMIND_BLUEPRINT_LIVE_AUDIT_ALLOW_MOCK=1

# Reserved provider slots. Add keys here now or later; QuorumMind will report
# them in /api/health, and adapters can be added without changing the frontend.
#
# ANTHROPIC_API_KEY=
# ANTHROPIC_MODEL=claude-sonnet-4.5
#
# XAI_API_KEY=
# XAI_MODEL=grok-4
#
# MISTRAL_API_KEY=
# MISTRAL_MODEL=mistral-large-latest
#
# OPENROUTER_API_KEY=
# OPENROUTER_MODEL=openai/gpt-5.2
#
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# TOGETHER_API_KEY=
# TOGETHER_MODEL=meta-llama/Llama-3.3-70B-Instruct-Turbo
#
# COHERE_API_KEY=
# COHERE_MODEL=command-a
#
# PERPLEXITY_API_KEY=
# PERPLEXITY_MODEL=sonar-pro
#
# Local model slots do not require API keys.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=llama3.1
#
# LMSTUDIO_BASE_URL=http://127.0.0.1:1234/v1
# LMSTUDIO_MODEL=local-model
