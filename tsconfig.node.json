{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "allowSyntheticDefaultImports": true,
    "types": ["node"],
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["vite.config.ts", "server/**/*.ts", "scripts/quorummind-cli.ts", "scripts/distribution-doctor.ts", "scripts/github-e2e.ts", "src/lib/**/*.ts", "src/types/**/*.ts", "src/i18n/**/*.ts"],
  "exclude": ["server/**/*.test.ts", "scripts/**/*.test.ts"]
}
